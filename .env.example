# Required. Reown (WalletConnect) project id for the wallet connect modal.
# Create one at https://dashboard.reown.com and add nerogate.org to its allowed domains.
VITE_REOWN_PROJECT_ID=

# Optional but recommended for launch. A Solana mainnet RPC URL (Helius, QuickNode, Triton...).
# Leave empty to use the free public RPC, which is rate limited.
VITE_SOLANA_RPC=
