# Required. Reown (WalletConnect) project id for the wallet connect modal (Ethereum mainnet).
# Create one at https://dashboard.reown.com and add nerogate.org to its allowed domains.
VITE_REOWN_PROJECT_ID=

# Optional but recommended for launch. An Ethereum mainnet RPC URL (Alchemy, Infura, QuickNode...).
# Leave empty to use the free public RPC (ethereum-rpc.publicnode.com), which is rate limited.
VITE_ETH_RPC=
